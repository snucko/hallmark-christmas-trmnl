{% assign today = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}
{% assign upcoming_movies = movies | where_exp: "movie", "movie.date >= today" %}
{% assign featured = upcoming_movies.first %}

<style>
  .plugin { width: 400px; height: 240px; padding: 12px; box-sizing: border-box; }
  .header { text-align: center; margin-bottom: 10px; border-bottom: 2px solid #000; padding-bottom: 6px; }
  .header h1 { font-size: 16px; margin: 0; font-weight: bold; }
  .featured-movie { display: flex; gap: 12px; align-items: center; }
  .movie-poster { width: 80px; height: 120px; border: 2px solid #000; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #fff; }
  .movie-poster img { max-width: 100%; max-height: 100%; }
  .movie-info { flex: 1; display: flex; flex-direction: column; }
  .tonight-label { font-size: 16px; font-weight: bold; margin: 0 0 6px 0; text-transform: uppercase; }
  .movie-title { font-size: 15px; font-weight: bold; margin: 0 0 6px 0; line-height: 1.2; }
  .movie-time { font-size: 13px; margin: 3px 0; font-weight: bold; }
  .movie-channel { font-size: 11px; margin: 3px 0; }
  .premiere-badge { display: inline-block; background: #000; color: #fff; padding: 3px 8px; font-size: 10px; font-weight: bold; margin-top: 4px; }
</style>

<div class="plugin">
  <div class="header">
    <h1>Hallmark Christmas</h1>
  </div>

  {% if featured %}
  <div class="featured-movie">
    <div class="movie-poster">
      {% if featured.image %}
        <img class="image-dither" src="https://raw.githubusercontent.com/snucko/hallmark-christmas-trmnl/main/{{ featured.image }}" alt="{{ featured.title }}">
      {% endif %}
    </div>
    <div class="movie-info">
      {% if featured.date == today %}<p class="tonight-label">Tonight!</p>{% endif %}
      <h2 class="movie-title">{{ featured.title }}</h2>
      {% unless featured.date == today %}<p class="movie-time">{{ featured.date | date: "%a, %b %d" }}</p>{% endunless %}
      <p class="movie-time">{{ featured.time | replace: ":00", "" | replace: "20", "8 PM" | replace: "21", "9 PM" | replace: "18", "6 PM" }} ET</p>
      <p class="movie-channel">{{ featured.channel }}</p>
      {% if featured.premiere %}<span class="premiere-badge">PREMIERE</span>{% endif %}
    </div>
  </div>
  {% else %}
  <p class="movie-title">No upcoming movies</p>
  {% endif %}
</div>