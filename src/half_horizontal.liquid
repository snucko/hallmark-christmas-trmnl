{% assign today = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}
{% assign upcoming_movies = movies | where_exp: "movie", "movie.date >= today" %}

<style>
  .plugin { width: 100%; height: 100%; padding: 8px 10px; box-sizing: border-box; overflow: hidden; }
  .header { text-align: center; margin-bottom: 8px; border-bottom: 2px solid #000; padding-bottom: 5px; }
  .header h1 { font-size: 24px; margin: 0; font-weight: 700; line-height: 1.1; }
  .movies-row { display: flex; gap: 15px; justify-content: space-between; }
  .movie { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; text-align: center; border: 2px solid #000; padding: 6px; }
  .movie-poster { width: 50px; height: 75px; border: 1px solid #000; margin-bottom: 4px; display: flex; align-items: center; justify-content: center; background: #fff; }
  .movie-poster img { max-width: 100%; max-height: 100%; }
  .movie-title { font-size: 13px; font-weight: 600; margin: 0 0 3px 0; line-height: 1.25; max-height: 33px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .movie-time { font-size: 11px; margin: 0; font-weight: 600; }
  .premiere-badge { display: inline-block; background: #000; color: #fff; padding: 1px 4px; font-size: 8px; font-weight: bold; margin-top: 2px; }
</style>

<div class="plugin">
  <div class="header">
    <h1>Hallmark Movies</h1>
  </div>

  <div class="movies-row">
    {% for movie in upcoming_movies limit: 4 %}
      <div class="movie">
        <div class="movie-poster">
          {% if movie.image %}
            <img class="image-dither" src="https://raw.githubusercontent.com/snucko/hallmark-christmas-trmnl/main/{{ movie.image }}" alt="{{ movie.title }}">
          {% endif %}
        </div>
        <h2 class="movie-title">{{ movie.title | truncate: 35 }}</h2>
        {% if movie.date == today %}
          <p class="movie-time">Tonight {{ movie.time | replace: ":00", "" | replace: "20", "8 PM" | replace: "21", "9 PM" | replace: "18", "6 PM" | replace: "22", "10 PM" }}</p>
        {% else %}
          <p class="movie-time">{{ movie.date | date: "%b %d" }} {{ movie.time | replace: ":00", "" | replace: "20", "8PM" | replace: "21", "9PM" | replace: "18", "6PM" | replace: "22", "10PM" }}</p>
        {% endif %}
        {% if movie.premiere %}
          <span class="premiere-badge">PREMIERE</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>